<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 집/사내 NAS의 WebDAV·HTTP 서버는 대부분 평문 HTTP 또는 자체 서명 인증서를 쓴다 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
